[layer_names]

3d_physics/layer_1="ground"
3d_physics/layer_2="obstacles"
3d_physics/layer_3="boundary"
3d_physics/layer_4="player"
3d_physics/layer_5="interactables"
3d_physics/layer_6="camera_blockers"

[navigation]

world/map_use_async_iterations=false
world/region_use_async_iterations=false
3d/default_cell_size=0.25
3d/default_cell_height=0.25

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[shader_globals]

wind_strength={
"type": "float",
"value": 0.0
}
wind_grass_only={
"type": "float",
"value": 0.0
}
